{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:schema": "node ../scripts/generate-offline-schema.mjs",
    "sync:context": "node ../scripts/sync-project-context-to-assets.mjs",
    "verify:sql": "node ../scripts/verify-sql.mjs && node ../scripts/verify-indicators.mjs && node ../scripts/verify-async-sync.mjs && node ../scripts/verify-chart-sync.mjs",
    "verify:sql:core": "node ../scripts/verify-sql.mjs --core-only && node ../scripts/verify-indicators.mjs && node ../scripts/verify-async-sync.mjs && node ../scripts/verify-chart-sync.mjs",
    "verify:indicators": "node ../scripts/verify-indicators.mjs",
    "prebuild": "npm run sync:context && npm run verify:sql && npm run test:unit && npm run generate:schema",
    "prestart": "npm run sync:context",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "ng test --no-watch --browsers=ChromeHeadless"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.2"
  }
}
